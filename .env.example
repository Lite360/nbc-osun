# NBC Osun Environment Variables Configuration

# Neon PostgreSQL Database Connection String
# Example: postgresql://neondb_owner:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_db_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
VITE_DATABASE_URL=postgresql://neondb_owner:your_neon_db_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob File Storage Token
# Example: vercel_blob_rw_abcdef123456789
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder_token

# Administrative Authentication Secret
AUTH_SECRET=nbc_osun_super_secure_session_secret_2026
